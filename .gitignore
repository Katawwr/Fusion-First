.idea/
.DS_Store
Thumbs.db
desktop.ini

# Windows redirect artifacts
nul
**/nul

# Build/eval scratch
evals/scratch/
*.tmp

# Python build artifacts
dist/
build/
*.whl
# Data copied into the wheel at build time (source of truth stays at repo top level)
fusion_first/_bundled/
# Playwright verification screenshots
.playwright-mcp/

# External benchmark downloads (raw, licensed per source). Only processed subsets + SOURCES.yaml are committed.
datasets/external/raw/

# Local run store (fusion run / MCP start_run), caches and proofs: all local state.
.fusion/
# Except the committed example run CI verifies; its run-local key, leases, heartbeat and lock stay out.
!examples/verified-run/.fusion/
examples/verified-run/.fusion/**/.secret
examples/verified-run/.fusion/**/leases.json
examples/verified-run/.fusion/**/heartbeat.json
examples/verified-run/.fusion/**/.lock
# The committed example tool-loop run (qwen2.5:7b through the loop, --corpus v2), verified the same way.
!examples/verified-run-toolloop/.fusion/
examples/verified-run-toolloop/.fusion/**/.secret
examples/verified-run-toolloop/.fusion/**/leases.json
examples/verified-run-toolloop/.fusion/**/heartbeat.json
examples/verified-run-toolloop/.fusion/**/.lock

# Claude Code agent worktrees (harness-managed)
.claude/worktrees/


# Local Claude Code working files: agent settings and session hooks, the coding-agent guide, session handoff
