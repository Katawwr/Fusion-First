# Data files are hashed for provenance: keep them LF everywhere so hashes match on every OS.
datasets/**/*.jsonl text eol=lf
datasets/**/*.json text eol=lf
cassettes/**/*.json text eol=lf
evals/**/*.json text eol=lf
evals/**/*.yaml text eol=lf
crosswalk/**/*.yaml text eol=lf
# The committed example run: `fusion run verify` hashes these bytes exactly, so git never converts them.
examples/verified-run/** -text
