{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|WebFetch|Write|Edit|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [{ "type": "command", "command": "fusion hook pre-tool-use", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch|mcp__.*",
        "hooks": [{ "type": "command", "command": "fusion hook post-tool-use", "timeout": 10 }]
      }
    ]
  }
}
