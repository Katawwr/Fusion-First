{
  "permissions": {
    "deny": [
      "Bash(claude auth login*)",
      "Bash(claude auth logout*)",
      "Bash(claude auth setup-token*)",
      "Bash(claude setup-token*)",
      "Bash(claude logout*)",
      "Bash(claude login*)",
      "PowerShell(claude auth login*)",
      "PowerShell(claude auth logout*)",
      "PowerShell(claude auth setup-token*)",
      "PowerShell(claude setup-token*)",
      "PowerShell(claude logout*)",
      "PowerShell(claude login*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/post_edit_lint.py\"" }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/context_handoff.py\"", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/context_handoff.py\"", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/pre_deploy_gate.py\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/stop_gate.py\"" },
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/context_handoff.py\"", "timeout": 10 }
        ]
      }
    ]
  }
}
