{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.factory:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000,
      "env": {
        "FUSION_ALLOW_LOCAL_BACKENDS": "1"
      }
    },
    {
      "name": "serve",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "fusion_first.cli", "serve", "--no-open", "--port", "8765"],
      "port": 8765
    },
    {
      "name": "serve-alt",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "fusion_first.cli", "serve", "--no-open", "--port", "8766"],
      "port": 8766
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
